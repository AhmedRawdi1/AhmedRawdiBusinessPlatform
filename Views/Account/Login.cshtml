@model AhmedRawdiBusinessPlatform.Models.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Sign In - Ahmed Rawdi Business Platform";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --primary-light: rgba(37, 99, 235, 0.1);
            --primary-glow: rgba(37, 99, 235, 0.25);
            --bg-main: #0f172a;
            --bg-card: #1e293b;
            --text-heading: #f8fafc;
            --text-body: #94a3b8;
            --text-muted: #64748b;
            --border-color: rgba(255, 255, 255, 0.1);
            --input-bg: rgba(15, 23, 42, 0.6);
            --input-border: rgba(255, 255, 255, 0.12);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-heading);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
        }

        .login-container {
            width: 100%;
            min-height: 100vh;
            display: flex;
        }

        /* Left Showcase Panel */
        .showcase-panel {
            flex: 1.1;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.55) 0%, rgba(2, 6, 23, 0.78) 100%),
                        url('/images/login-bg.png') no-repeat center center / cover;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 4rem;
            overflow: hidden;
            border-right: 1px solid var(--border-color);
        }

        .showcase-bg-grid {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px);
            background-size: 32px 32px;
            mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
            pointer-events: none;
        }

        .showcase-glow {
            position: absolute;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.2) 0%, rgba(147, 51, 234, 0.1) 50%, transparent 70%);
            filter: blur(60px);
            top: -10%;
            left: -10%;
            pointer-events: none;
        }

        .brand-logo-group {
            display: flex;
            align-items: center;
            gap: 1rem;
            position: relative;
            z-index: 2;
        }

        .brand-icon-box {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: #ffffff;
            box-shadow: 0 8px 20px rgba(59, 130, 246, 0.35);
        }

        .brand-name {
            font-weight: 700;
            font-size: 1.35rem;
            letter-spacing: -0.02em;
            background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .showcase-content {
            position: relative;
            z-index: 2;
            max-width: 520px;
            margin: auto 0;
        }

        .badge-enterprise {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.4rem 0.9rem;
            background: rgba(59, 130, 246, 0.12);
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 999px;
            font-size: 0.825rem;
            font-weight: 600;
            color: #60a5fa;
            margin-bottom: 1.5rem;
        }

        .showcase-headline {
            font-size: 2.75rem;
            font-weight: 800;
            line-height: 1.2;
            letter-spacing: -0.03em;
            margin-bottom: 1.25rem;
            background: linear-gradient(135deg, #ffffff 0%, #94a3b8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .showcase-desc {
            font-size: 1.05rem;
            color: var(--text-body);
            line-height: 1.6;
            margin-bottom: 2.5rem;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.25rem;
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 1.25rem;
            backdrop-filter: blur(10px);
        }

        .feature-icon {
            font-size: 1.25rem;
            color: #60a5fa;
            margin-bottom: 0.5rem;
        }

        .feature-title {
            font-size: 0.925rem;
            font-weight: 600;
            color: var(--text-heading);
            margin-bottom: 0.2rem;
        }

        .feature-sub {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .showcase-footer {
            position: relative;
            z-index: 2;
            font-size: 0.85rem;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* Right Form Panel */
        .form-panel {
            flex: 0.9;
            background: var(--bg-main);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 2rem;
            position: relative;
        }

        .form-card {
            width: 100%;
            max-width: 420px;
        }

        .form-header {
            margin-bottom: 2.25rem;
        }

        .form-title {
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: -0.025em;
            color: var(--text-heading);
            margin-bottom: 0.5rem;
        }

        .form-subtitle {
            font-size: 0.95rem;
            color: var(--text-body);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text-body);
            margin-bottom: 0.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon-left {
            position: absolute;
            left: 1.1rem;
            color: var(--text-muted);
            font-size: 1.15rem;
            transition: color 0.2s ease;
            pointer-events: none;
            z-index: 2;
        }

        .form-input {
            width: 100%;
            background: var(--input-bg);
            border: 1px solid var(--input-border);
            border-radius: 12px;
            padding: 0.9rem 1.1rem 0.9rem 2.9rem;
            font-size: 0.95rem;
            color: var(--text-heading);
            font-family: inherit;
            outline: none;
            transition: all 0.2s ease;
        }

        .form-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--primary-glow);
            background: rgba(15, 23, 42, 0.9);
        }

        .form-input:focus ~ .input-icon-left {
            color: var(--primary);
        }

        .btn-toggle-password {
            position: absolute;
            right: 1rem;
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 1.1rem;
            padding: 0.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s ease;
            z-index: 2;
        }

        .btn-toggle-password:hover {
            color: var(--text-heading);
        }

        .form-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.75rem;
        }

        .checkbox-container {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            cursor: pointer;
            font-size: 0.875rem;
            color: var(--text-body);
            user-select: none;
        }

        .checkbox-container input {
            accent-color: var(--primary);
            width: 17px;
            height: 17px;
            border-radius: 4px;
            cursor: pointer;
        }

        .btn-login {
            width: 100%;
            padding: 0.95rem;
            background: linear-gradient(135deg, var(--primary), #3b82f6);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.25s ease;
            box-shadow: 0 4px 14px var(--primary-glow);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
        }

        .btn-login:hover {
            background: linear-gradient(135deg, var(--primary-hover), var(--primary));
            transform: translateY(-1px);
            box-shadow: 0 8px 24px var(--primary-glow);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .alert-error {
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.25);
            border-radius: 12px;
            color: #fca5a5;
            padding: 0.9rem 1.1rem;
            font-size: 0.875rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
        }

        .security-badge {
            margin-top: 2.5rem;
            text-align: center;
            font-size: 0.8rem;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
        }

        @@media (max-width: 992px) {
            .showcase-panel {
                display: none;
            }
            .form-panel {
                flex: 1;
                padding: 2rem 1.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- Left Showcase Panel -->
        <div class="showcase-panel">
            <div class="showcase-bg-grid"></div>
            <div class="showcase-glow"></div>

            <div class="brand-logo-group">
                <div class="brand-icon-box">
                    <i class="bi bi-shield-check"></i>
                </div>
                <span class="brand-name">Ahmed Rawdi Platform</span>
            </div>

            <div class="showcase-content">
                <div class="badge-enterprise">
                    <i class="bi bi-patch-check-fill"></i>
                    <span>Enterprise ERP & Business Intelligence</span>
                </div>

                <h2 class="showcase-headline">Empowering Business with Precision & Insight</h2>
                <p class="showcase-desc">
                    Streamlined workflow management, real-time analytics, and secure centralized access tailored for modern business execution.
                </p>

                <div class="feature-grid">
                    <div class="feature-card">
                        <i class="bi bi-shield-lock feature-icon"></i>
                        <div class="feature-title">Secure Access</div>
                        <div class="feature-sub">Role-based SQL procedure auth</div>
                    </div>
                    <div class="feature-card">
                        <i class="bi bi-graph-up-arrow feature-icon"></i>
                        <div class="feature-title">Real-Time Data</div>
                        <div class="feature-sub">High performance analytics</div>
                    </div>
                </div>
            </div>

            <div class="showcase-footer">
                <span>&copy; @DateTime.Now.Year Ahmed Rawdi Business Platform</span>
                <span>v1.0.0</span>
            </div>
        </div>

        <!-- Right Login Panel -->
        <div class="form-panel">
            <div class="form-card">
                <div class="form-header">
                    <h1 class="form-title">Welcome back</h1>
                    <p class="form-subtitle">Please enter your credentials to sign in</p>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert-error" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0 mt-1"></i>
                        <div>
                            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    </div>
                }

                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label asp-for="UserCode" class="form-label">User Code</label>
                        <div class="input-wrapper">
                            <input asp-for="UserCode" class="form-input" placeholder="e.g. Admin" id="UserCodeInput" autocomplete="username" autofocus />
                            <i class="bi bi-person-badge input-icon-left"></i>
                        </div>
                        <span asp-validation-for="UserCode" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-wrapper">
                            <input asp-for="Password" class="form-input" type="password" placeholder="••••••••" id="PasswordInput" autocomplete="current-password" />
                            <i class="bi bi-lock input-icon-left"></i>
                            <button type="button" class="btn-toggle-password" id="togglePasswordBtn" title="Toggle password visibility">
                                <i class="bi bi-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-options">
                        <label class="checkbox-container">
                            <input asp-for="RememberMe" type="checkbox" />
                            <span>Keep me signed in</span>
                        </label>
                    </div>

                    <button type="submit" class="btn-login" id="btnLogin">
                        <span>Sign In</span>
                        <i class="bi bi-arrow-right-short fs-4"></i>
                    </button>
                </form>

                <div class="security-badge">
                    <i class="bi bi-lock-fill"></i>
                    <span>256-Bit Encrypted • Enterprise Authentication</span>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const togglePasswordBtn = document.getElementById('togglePasswordBtn');
            const passwordInput = document.getElementById('PasswordInput');
            const togglePasswordIcon = document.getElementById('togglePasswordIcon');

            if (togglePasswordBtn && passwordInput && togglePasswordIcon) {
                togglePasswordBtn.addEventListener('click', function () {
                    const isPassword = passwordInput.getAttribute('type') === 'password';
                    passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                    
                    if (isPassword) {
                        togglePasswordIcon.classList.replace('bi-eye', 'bi-eye-slash');
                    } else {
                        togglePasswordIcon.classList.replace('bi-eye-slash', 'bi-eye');
                    }
                });
            }
        });
    </script>
</body>
</html>
