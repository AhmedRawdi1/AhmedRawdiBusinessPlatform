@model AhmedRawdiBusinessPlatform.Models.LoginViewModel
@inject AhmedRawdiBusinessPlatform.Services.ILanguageService Lang

@{
    Layout = null;
    ViewData["Title"] = Lang.Get("SignIn") + " - " + Lang.Get("BrandTitle");
}

<!DOCTYPE html>
<html lang="@(Lang.IsRightToLeft ? "ar" : "en")" dir="@(Lang.IsRightToLeft ? "rtl" : "ltr")" data-theme="light" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <script>
        (function() {
            var theme = localStorage.getItem('sb|theme-mode') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    
    @if (Lang.IsRightToLeft)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --primary-light: rgba(37, 99, 235, 0.08);
            --primary-glow: rgba(37, 99, 235, 0.2);
            --secondary: #4f46e5;
            
            /* Eye-Comfort Color Palette */
            --slate-900: #0f172a;
            --slate-800: #1e293b;
            --slate-700: #334155;
            --slate-600: #475569;
            --slate-500: #64748b;
            --slate-400: #94a3b8;
            --slate-300: #cbd5e1;
            --slate-200: #e2e8f0;
            --slate-100: #f1f5f9;
            --slate-50: #f8fafc;
        }

        /* ----------------------------------------------------
           LIGHT MODE EYE-COMFORT OVERRIDES
        ---------------------------------------------------- */
        [data-theme="light"] .form-panel {
            background-color: var(--slate-50) !important;
            color: var(--slate-800) !important;
        }
        [data-theme="light"] .form-title {
            color: var(--slate-900) !important;
        }
        [data-theme="light"] .form-subtitle {
            color: var(--slate-600) !important;
        }
        [data-theme="light"] .form-label {
            color: var(--slate-700) !important;
        }
        [data-theme="light"] .form-input {
            background-color: #ffffff !important;
            border-color: var(--slate-200) !important;
            color: var(--slate-900) !important;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03);
        }
        [data-theme="light"] .form-input:focus {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 4px var(--primary-glow) !important;
            background-color: #ffffff !important;
        }
        [data-theme="light"] .checkbox-container {
            color: var(--slate-600) !important;
        }
        [data-theme="light"] .security-badge {
            color: var(--slate-500) !important;
            border-top-color: var(--slate-200) !important;
        }
        [data-theme="light"] .lang-switcher-top .btn {
            background-color: #ffffff !important;
            color: var(--slate-800) !important;
            border: 1px solid var(--slate-300) !important;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05) !important;
        }
        [data-theme="light"] .lang-switcher-top .btn #themeToggleIcon {
            color: #d97706 !important;
        }
        [data-theme="light"] .lang-switcher-top .btn:hover {
            background-color: var(--slate-100) !important;
            color: var(--primary) !important;
        }

        /* ----------------------------------------------------
           DARK MODE EYE-COMFORT OVERRIDES
        ---------------------------------------------------- */
        [data-theme="dark"] .form-panel {
            background-color: var(--slate-900) !important;
            color: var(--slate-300) !important;
        }
        [data-theme="dark"] .form-title {
            color: #f8fafc !important;
        }
        [data-theme="dark"] .form-subtitle {
            color: var(--slate-400) !important;
        }
        [data-theme="dark"] .form-label {
            color: var(--slate-300) !important;
        }
        [data-theme="dark"] .form-input {
            background-color: var(--slate-800) !important;
            border-color: rgba(255, 255, 255, 0.12) !important;
            color: #f8fafc !important;
        }
        [data-theme="dark"] .form-input:focus {
            border-color: #60a5fa !important;
            box-shadow: 0 0 0 4px rgba(96, 165, 250, 0.2) !important;
        }
        [data-theme="dark"] .checkbox-container {
            color: var(--slate-300) !important;
        }
        [data-theme="dark"] .security-badge {
            color: var(--slate-400) !important;
            border-top-color: rgba(255, 255, 255, 0.1) !important;
        }
        [data-theme="dark"] .lang-switcher-top .btn {
            background-color: rgba(30, 41, 59, 0.8) !important;
            color: #f8fafc !important;
            border: 1px solid rgba(255, 255, 255, 0.18) !important;
        }
        [data-theme="dark"] .lang-switcher-top .btn:hover {
            background-color: var(--slate-800) !important;
            color: #ffffff !important;
        }

        /* ----------------------------------------------------
           CORE BASE LAYOUT
        ---------------------------------------------------- */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: @(Lang.IsRightToLeft ? "'Cairo', 'Plus Jakarta Sans', sans-serif" : "'Plus Jakarta Sans', sans-serif");
            background-color: var(--slate-900);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
        }

        .login-container {
            width: 100%;
            min-height: 100vh;
            display: flex;
        }

        /* Lang & Theme Switcher Top Controls */
        .lang-switcher-top {
            position: absolute;
            top: 1.5rem;
            @(Lang.IsRightToLeft ? "left: 1.5rem;" : "right: 1.5rem;")
            z-index: 100;
        }

        /* Left Showcase Panel */
        .showcase-panel {
            flex: 1.15;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.75) 0%, rgba(2, 6, 23, 0.90) 100%),
                        url('/images/login-bg-eye-comfort.png') no-repeat center center / cover;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 3.5rem 4rem;
            color: #ffffff;
            overflow: hidden;
        }

        .showcase-glow {
            position: absolute;
            top: -20%;
            left: -20%;
            width: 80%;
            height: 80%;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.15) 0%, rgba(0, 0, 0, 0) 70%);
            pointer-events: none;
        }

        .brand-logo-group {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 0.85rem;
        }

        .brand-icon-box {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            color: #ffffff;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
        }

        .brand-name {
            font-size: 1.25rem;
            font-weight: 800;
            letter-spacing: -0.025em;
            color: #ffffff;
        }

        .showcase-content {
            position: relative;
            z-index: 2;
            max-width: 580px;
            margin: auto 0;
        }

        .badge-enterprise {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.45rem 1rem;
            background: rgba(37, 99, 235, 0.18);
            border: 1px solid rgba(96, 165, 250, 0.3);
            border-radius: 50px;
            font-size: 0.825rem;
            font-weight: 600;
            color: #93c5fd;
            margin-bottom: 1.5rem;
            backdrop-filter: blur(8px);
        }

        .showcase-headline {
            font-size: 2.35rem;
            font-weight: 800;
            line-height: 1.25;
            letter-spacing: -0.03em;
            margin-bottom: 1rem;
            background: linear-gradient(180deg, #ffffff 0%, #cbd5e1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .showcase-desc {
            font-size: 1rem;
            line-height: 1.6;
            color: var(--slate-300);
            margin-bottom: 2rem;
        }

        .showcase-hero-box {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .feature-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.25rem;
            margin-top: 1.5rem;
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 1.25rem;
            backdrop-filter: blur(10px);
            transition: transform 0.2s ease, background 0.2s ease;
        }

        .feature-card:hover {
            background: rgba(255, 255, 255, 0.07);
            transform: translateY(-2px);
        }

        .feature-icon {
            font-size: 1.35rem;
            color: #60a5fa;
            margin-bottom: 0.5rem;
        }

        .feature-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 0.25rem;
        }

        .feature-sub {
            font-size: 0.825rem;
            color: var(--slate-400);
            line-height: 1.4;
        }

        .showcase-footer {
            position: relative;
            z-index: 2;
            font-size: 0.85rem;
            color: var(--slate-400);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* ----------------------------------------------------
           RIGHT FORM PANEL (EYE-COMFORT DESIGN)
        ---------------------------------------------------- */
        .form-panel {
            flex: 0.85;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3.5rem 3rem;
            position: relative;
            transition: background-color 0.25s ease;
        }

        .form-card {
            width: 100%;
            max-width: 420px;
        }

        .form-header {
            margin-bottom: 2.25rem;
        }

        .form-title {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            margin-bottom: 0.4rem;
        }

        .form-subtitle {
            font-size: 0.925rem;
            line-height: 1.5;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            font-size: 0.875rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            display: block;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .form-input {
            width: 100%;
            height: 3.25rem;
            border-radius: 0.75rem;
            font-size: 0.95rem;
            font-weight: 500;
            outline: none;
            transition: all 0.2s ease-in-out;
            @(Lang.IsRightToLeft ? "padding: 0 3rem 0 1rem;" : "padding: 0 1rem 0 3rem;")
        }

        .input-icon-left {
            position: absolute;
            @(Lang.IsRightToLeft ? "right: 1.1rem;" : "left: 1.1rem;")
            color: var(--slate-400);
            font-size: 1.2rem;
            pointer-events: none;
            transition: color 0.2s ease;
        }

        .form-input:focus + .input-icon-left {
            color: var(--primary);
        }

        .btn-toggle-password {
            position: absolute;
            @(Lang.IsRightToLeft ? "left: 0.85rem;" : "right: 0.85rem;")
            background: transparent;
            border: none;
            color: var(--slate-400);
            font-size: 1.15rem;
            padding: 0.35rem;
            cursor: pointer;
            border-radius: 0.35rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s ease;
        }

        .btn-toggle-password:hover {
            color: var(--primary);
        }

        .form-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
            font-size: 0.875rem;
        }

        .checkbox-container {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            cursor: pointer;
            font-weight: 500;
            user-select: none;
        }

        .checkbox-container input[type="checkbox"] {
            width: 1.15rem;
            height: 1.15rem;
            border-radius: 0.35rem;
            accent-color: var(--primary);
            cursor: pointer;
        }

        .btn-login {
            width: 100%;
            height: 3.25rem;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: #ffffff;
            border: none;
            border-radius: 0.75rem;
            font-size: 1rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
            transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
        }

        .btn-login:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .security-badge {
            margin-top: 2.25rem;
            padding-top: 1.5rem;
            border-top: 1px solid;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            font-size: 0.825rem;
            font-weight: 500;
        }

        .alert-error {
            background-color: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.25);
            color: #ef4444;
            padding: 0.85rem 1.15rem;
            border-radius: 0.75rem;
            font-size: 0.875rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
        }

        /* ----------------------------------------------------
           RESPONSIVE BREAKPOINTS
        ---------------------------------------------------- */
        @@media (max-width: 992px) {
            .showcase-panel {
                display: none;
            }
            .form-panel {
                flex: 1;
                padding: 2.5rem 1.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- Top Language & Theme Switcher -->
        <div class="lang-switcher-top d-flex align-items-center gap-2">
            <button class="btn btn-sm rounded-circle p-2 shadow-sm" id="themeToggle" title="Toggle Light / Dark Mode" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;">
                <i class="bi bi-sun-fill fs-6" id="themeToggleIcon"></i>
            </button>
            <a href="/Language/SetLanguage?culture=@Lang.Get("SwitchLangCulture")&returnUrl=@(Context.Request.Path + Context.Request.QueryString)" 
               class="btn btn-sm rounded-pill px-3 shadow-sm font-weight-bold">
                <i class="bi bi-globe me-1 ms-1"></i> @Lang.Get("SwitchLang")
            </a>
        </div>

        <!-- Left Showcase Panel -->
        <div class="showcase-panel">
            <div class="showcase-glow"></div>

            <div class="brand-logo-group">
                <div class="brand-icon-box">
                    <i class="bi bi-shield-check"></i>
                </div>
                <span class="brand-name">@Lang.Get("BrandTitle")</span>
            </div>

            <div class="showcase-content">
                <div class="badge-enterprise">
                    <i class="bi bi-patch-check-fill"></i>
                    <span>@Lang.Get("EnterpriseBadge")</span>
                </div>

                <h2 class="showcase-headline">@Lang.Get("EmpoweringHeadline")</h2>
                <p class="showcase-desc">
                    @Lang.Get("EmpoweringDesc")
                </p>

                <div class="showcase-hero-box my-3">
                    <img src="~/images/login-bg-eye-comfort.png" alt="@Lang.Get("BrandTitle")" class="img-fluid rounded-4 shadow-lg" style="max-height: 210px; width: 100%; object-fit: cover;" />
                </div>

                <div class="feature-grid">
                    <div class="feature-card">
                        <i class="bi bi-shield-lock feature-icon"></i>
                        <div class="feature-title">@Lang.Get("SecureAccess")</div>
                        <div class="feature-sub">@Lang.Get("RoleBasedAuth")</div>
                    </div>
                    <div class="feature-card">
                        <i class="bi bi-graph-up-arrow feature-icon"></i>
                        <div class="feature-title">@Lang.Get("RealTimeData")</div>
                        <div class="feature-sub">@Lang.Get("HighPerformanceAnalytics")</div>
                    </div>
                </div>
            </div>

            <div class="showcase-footer">
                <span>&copy; @DateTime.Now.Year @Lang.Get("BrandTitle")</span>
                <span>v1.0.0</span>
            </div>
        </div>

        <!-- Right Login Panel -->
        <div class="form-panel">
            <div class="form-card">
                <div class="form-header">
                    <h1 class="form-title">@Lang.Get("SignIn")</h1>
                    <p class="form-subtitle">@Lang.Get("SignInSubtitle")</p>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert-error" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0 mt-1"></i>
                        <div>
                            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    </div>
                }

                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label asp-for="UserCode" class="form-label">@Lang.Get("UserCode")</label>
                        <div class="input-wrapper">
                            <input asp-for="UserCode" class="form-input" placeholder="e.g. Admin" id="UserCodeInput" autocomplete="username" autofocus />
                            <i class="bi bi-person-badge input-icon-left"></i>
                        </div>
                        <span asp-validation-for="UserCode" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label">@Lang.Get("Password")</label>
                        <div class="input-wrapper">
                            <input asp-for="Password" class="form-input" type="password" placeholder="••••••••" id="PasswordInput" autocomplete="current-password" />
                            <i class="bi bi-lock input-icon-left"></i>
                            <button type="button" class="btn-toggle-password" id="togglePasswordBtn" title="Toggle password visibility">
                                <i class="bi bi-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-options">
                        <label class="checkbox-container">
                            <input asp-for="RememberMe" type="checkbox" />
                            <span>@Lang.Get("RememberMe")</span>
                        </label>
                    </div>

                    <button type="submit" class="btn-login" id="btnLogin">
                        <span>@Lang.Get("SignIn")</span>
                        <i class="bi @(Lang.IsRightToLeft ? "bi-arrow-left-short" : "bi-arrow-right-short") fs-4"></i>
                    </button>
                </form>

                <div class="security-badge">
                    <i class="bi bi-lock-fill"></i>
                    <span>@Lang.Get("EncryptedBadge")</span>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const togglePasswordBtn = document.getElementById('togglePasswordBtn');
            const passwordInput = document.getElementById('PasswordInput');
            const togglePasswordIcon = document.getElementById('togglePasswordIcon');

            if (togglePasswordBtn && passwordInput && togglePasswordIcon) {
                togglePasswordBtn.addEventListener('click', function () {
                    const isPassword = passwordInput.getAttribute('type') === 'password';
                    passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                    
                    if (isPassword) {
                        togglePasswordIcon.classList.replace('bi-eye', 'bi-eye-slash');
                    } else {
                        togglePasswordIcon.classList.replace('bi-eye-slash', 'bi-eye');
                    }
                });
            }
        });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
