@model ChangePasswordViewModel
@inject AhmedRawdiBusinessPlatform.Services.ILanguageService Lang
@{ Layout = null; ViewData["Title"] = "Change Password"; }
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Change Password · @Lang.Get("BrandShort")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <main class="container d-flex min-vh-100 align-items-center justify-content-center py-5">
        <section class="card border-0 shadow-lg" style="max-width:560px;width:100%;border-radius:1.25rem;overflow:hidden">
            <div style="height:6px;background:#1a6497"></div>
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle text-white" style="width:52px;height:52px;background:#1a6497"><i class="bi bi-shield-lock fs-4"></i></span>
                    <div><small class="text-uppercase fw-semibold text-secondary">Secure account</small><h1 class="h3 mb-0">Change your password</h1></div>
                </div>
                <p class="text-secondary">Create a private password before continuing. All previous sessions will be signed out.</p>
                <form asp-action="ChangePassword" method="post" autocomplete="off">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3"><label asp-for="CurrentPassword" class="form-label fw-semibold">Current password</label><input asp-for="CurrentPassword" class="form-control form-control-lg" autocomplete="current-password" /><span asp-validation-for="CurrentPassword" class="text-danger"></span></div>
                    <div class="mb-3"><label asp-for="NewPassword" class="form-label fw-semibold">New password</label><input asp-for="NewPassword" class="form-control form-control-lg" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger"></span></div>
                    <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm new password</label><input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
                    <button class="btn btn-lg text-white w-100" style="background:#1a6497" type="submit">Save password and sign in again</button>
                </form>
            </div>
        </section>
    </main>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
