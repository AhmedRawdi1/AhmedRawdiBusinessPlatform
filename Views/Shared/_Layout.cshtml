@inject AhmedRawdiBusinessPlatform.Services.ILanguageService Lang
@{
    var engName = User.FindFirst("UserEnglishName")?.Value;
    var arbName = User.FindFirst("UserArabicName")?.Value;
    var displayName = Lang.IsRightToLeft ? (!string.IsNullOrWhiteSpace(arbName) ? arbName : engName) : (!string.IsNullOrWhiteSpace(engName) ? engName : User.Identity?.Name);
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Business User";
    var initial = !string.IsNullOrWhiteSpace(displayName) ? displayName[0].ToString().ToUpperInvariant() : "U";
}
<!DOCTYPE html>
<html lang="@(Lang.IsRightToLeft ? "ar" : "en")" dir="@(Lang.IsRightToLeft ? "rtl" : "ltr")" data-theme="light" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101828" />
    <title>@ViewData["Title"] · @Lang.Get("BrandShort")</title>
    <script>document.documentElement.dataset.theme=localStorage.getItem('arbp-theme')||'light';document.documentElement.setAttribute('data-bs-theme',document.documentElement.dataset.theme);</script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/@(Lang.IsRightToLeft ? "bootstrap.rtl.min.css" : "bootstrap.min.css")" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="mobile-backdrop" id="mobileBackdrop"></div>
    <aside class="app-sidebar" id="appSidebar" aria-label="Primary navigation">
        <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark"><i class="bi bi-command"></i></span>
            <span><strong>Ahmed Rawdi</strong><small>Business Platform</small></span>
        </a>
        <div class="sidebar-scroll">@await Component.InvokeAsync("NavigationMenu")</div>
        <div class="sidebar-user">
            <span class="avatar">@initial</span>
            <span class="sidebar-user-copy"><strong>@(displayName ?? "Guest")</strong><small>@role</small></span>
            <span class="status-dot" title="Online"></span>
        </div>
    </aside>

    <div class="app-frame">
        <header class="app-topbar">
            <div class="topbar-start">
                <button class="icon-button" id="sidebarToggle" type="button" aria-label="Toggle navigation" aria-expanded="false"><i class="bi bi-list"></i></button>
                <div class="page-context d-none d-sm-block"><small>@Lang.Get("BrandShort")</small><strong>@ViewData["Title"]</strong></div>
            </div>
            <div class="topbar-actions">
                <button class="icon-button d-none d-md-inline-flex" type="button" aria-label="Search"><i class="bi bi-search"></i></button>
                <button class="icon-button" id="themeToggle" type="button" aria-label="Toggle color theme"><i class="bi bi-moon-stars" id="themeToggleIcon"></i></button>
                <a class="language-pill" href="/Language/SetLanguage?culture=@Lang.Get("SwitchLangCulture")&returnUrl=@(Context.Request.Path + Context.Request.QueryString)"><i class="bi bi-globe2"></i><span>@Lang.Get("SwitchLang")</span></a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="profile-button dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><span class="avatar">@initial</span><span class="d-none d-lg-block"><strong>@displayName</strong><small>@role</small></span></button>
                        <div class="dropdown-menu dropdown-menu-end profile-menu">
                            <div class="profile-menu-head"><span class="avatar avatar-lg">@initial</span><div><strong>@displayName</strong><small>@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value)</small></div></div>
                            <a class="dropdown-item" href="javascript:void(0)"><i class="bi bi-person"></i>@Lang.Get("MyProfile")</a>
                            <a class="dropdown-item" href="javascript:void(0)"><i class="bi bi-sliders"></i>@Lang.Get("AccountSettings")</a>
                            <div class="dropdown-divider"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right"></i>@Lang.Get("SignOut")</button></form>
                        </div>
                    </div>
                }
            </div>
        </header>
        <main id="main-content" class="app-content">@RenderBody()</main>
        <footer class="app-footer"><span>© @DateTime.Now.Year @Lang.Get("BrandTitle")</span><span><a asp-controller="Home" asp-action="Privacy">@Lang.Get("PrivacyPolicy")</a><span class="mx-2">·</span>v1.0</span></footer>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
