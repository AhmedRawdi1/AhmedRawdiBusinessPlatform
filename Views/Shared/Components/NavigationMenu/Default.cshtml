@model AhmedRawdiBusinessPlatform.Models.NavigationMenuViewModel
@inject AhmedRawdiBusinessPlatform.Services.ILanguageService Lang
<nav class="sidebar-nav">
    <div class="nav-section-label">@Lang.Get("Core")</div>
    <a class="sidebar-link active" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2"></i><span>@Lang.Get("Dashboard")</span><span class="nav-active-mark"></span></a>
    @if (Model?.Modules.Any() == true)
    {
        foreach (var module in Model.Modules)
        {
            <div class="nav-section-label"><span>@module.Name</span></div>
            foreach (var sub in module.SubModules)
            {
                var id = $"nav-{sub.SubModuleID}";
                <button class="sidebar-link sidebar-collapse collapsed" data-bs-toggle="collapse" data-bs-target="#@id" aria-expanded="false"><i class="@sub.IconClass"></i><span>@sub.Name</span><i class="bi bi-chevron-down collapse-arrow"></i></button>
                <div class="collapse" id="@id">
                    <div class="sidebar-subnav">
                        @foreach (var form in sub.Forms)
                        {
                            <a class="sidebar-sublink" href="@form.Url"><i class="@form.IconClass"></i><span>@form.Name</span>@if(form.CanSave || form.CanUpdate){<span class="access-dot" title="Write access"></span>}</a>
                        }
                    </div>
                </div>
            }
        }
    }
    else
    {
        <div class="nav-section-label">@Lang.Get("BusinessModules")</div>
        <a class="sidebar-link" href="javascript:void(0)"><i class="bi bi-people"></i><span>@Lang.Get("SystemUsers")</span></a>
        <a class="sidebar-link" href="javascript:void(0)"><i class="bi bi-shield-check"></i><span>@Lang.Get("SystemGroups")</span></a>
        <a class="sidebar-link" href="javascript:void(0)"><i class="bi bi-bar-chart"></i><span>@Lang.Get("BusinessAnalytics")</span></a>
    }
    <div class="nav-section-label">@Lang.Get("SystemAndData")</div>
    <a class="sidebar-link" href="javascript:void(0)"><i class="bi bi-database"></i><span>@Lang.Get("SqlServer")</span></a>
    <a class="sidebar-link" asp-controller="Home" asp-action="Privacy"><i class="bi bi-lock"></i><span>@Lang.Get("PrivacyAndSecurity")</span></a>
</nav>
