@inject AhmedRawdiBusinessPlatform.Services.ILanguageService Lang
@{
    ViewData["Title"] = Lang.Get("Dashboard");
    var engName = User.FindFirst("UserEnglishName")?.Value;
    var arbName = User.FindFirst("UserArabicName")?.Value;
    var displayName = Lang.IsRightToLeft ? (!string.IsNullOrWhiteSpace(arbName) ? arbName : engName) : (!string.IsNullOrWhiteSpace(engName) ? engName : User.Identity?.Name);
    var code = User.Identity?.Name ?? "Admin";
    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "—";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "System Administrator";
    var group = User.FindFirst("GroupCode")?.Value ?? "SAG";
    var nav = ViewBag.NavMenu as NavigationMenuViewModel;
    var modules = nav?.Modules.Count ?? 0;
    var pages = nav?.Modules.Sum(x => x.SubModules.Sum(s => s.Forms.Count)) ?? 0;
}
<section class="dashboard-hero">
    <div class="hero-copy">
        <span class="eyebrow"><span class="pulse-dot"></span>@Lang.Get("ActiveSession")</span>
        <h1>@Lang.Get("WelcomeBack"), <span>@(displayName ?? code)</span></h1>
        <p>@Lang.Get("DashboardSubtitle")</p>
    </div>
    <div class="hero-actions">
        <span class="date-chip"><i class="bi bi-calendar3"></i>@DateTime.Now.ToString("dd MMM yyyy")</span>
        <a class="btn-primary-soft" asp-action="Index"><i class="bi bi-arrow-repeat"></i>@Lang.Get("RefreshData")</a>
    </div>
    <div class="hero-orb hero-orb-one"></div><div class="hero-orb hero-orb-two"></div>
</section>

<section class="metrics-grid" aria-label="Platform overview">
    <article class="metric-card tone-blue"><div class="metric-top"><span class="metric-icon"><i class="bi bi-person-check"></i></span><span class="metric-trend positive"><i class="bi bi-check2"></i>Online</span></div><span class="metric-caption">@Lang.Get("LoggedUser")</span><strong>@code</strong><small>@Lang.Get("AuthenticationActive")</small></article>
    <article class="metric-card tone-violet"><div class="metric-top"><span class="metric-icon"><i class="bi bi-shield-lock"></i></span><span class="metric-trend">@group</span></div><span class="metric-caption">@Lang.Get("SystemGroup")</span><strong>@role</strong><small>Role-based access</small></article>
    <article class="metric-card tone-green"><div class="metric-top"><span class="metric-icon"><i class="bi bi-layers"></i></span><span class="metric-trend positive"><i class="bi bi-arrow-up-right"></i>Ready</span></div><span class="metric-caption">Business modules</span><strong>@modules</strong><small>Connected modules</small></article>
    <article class="metric-card tone-orange"><div class="metric-top"><span class="metric-icon"><i class="bi bi-key"></i></span><span class="metric-trend">SQL</span></div><span class="metric-caption">Authorized pages</span><strong>@pages</strong><small>Current permission scope</small></article>
</section>

<section class="dashboard-grid">
    <article class="panel panel-profile">
        <div class="panel-heading"><div><span class="eyebrow-text">Account</span><h2>@Lang.Get("AuthenticatedUserDetails")</h2></div><span class="status-badge"><span></span>@Lang.Get("Active")</span></div>
        <div class="identity-card"><span class="identity-avatar">@((displayName ?? code)[0].ToString().ToUpperInvariant())</span><div><h3>@(displayName ?? code)</h3><p>@role</p></div></div>
        <dl class="detail-list">
            <div><dt><i class="bi bi-person"></i>@Lang.Get("UserCode")</dt><dd>@code</dd></div>
            <div><dt><i class="bi bi-envelope"></i>Email address</dt><dd>@email</dd></div>
            <div><dt><i class="bi bi-people"></i>@Lang.Get("SystemGroup")</dt><dd>@group</dd></div>
            <div><dt><i class="bi bi-clock-history"></i>Session</dt><dd>8 hours</dd></div>
        </dl>
    </article>
    <article class="panel">
        <div class="panel-heading"><div><span class="eyebrow-text">Infrastructure</span><h2>@Lang.Get("SystemArchitecture")</h2></div><button class="more-button" aria-label="More options"><i class="bi bi-three-dots"></i></button></div>
        <div class="architecture-list">
            <div><span class="architecture-icon blue"><i class="bi bi-braces"></i></span><div><strong>.NET 10 MVC</strong><small>@Lang.Get("Framework")</small></div><span class="status-badge"><span></span>Healthy</span></div>
            <div><span class="architecture-icon violet"><i class="bi bi-database"></i></span><div><strong>SQL Server · ARBP</strong><small>@Lang.Get("DatabaseEngine")</small></div><span class="architecture-meta">AHMEDRAWDI</span></div>
            <div><span class="architecture-icon green"><i class="bi bi-diagram-3"></i></span><div><strong>Entity Framework Core</strong><small>@Lang.Get("OrmProvider")</small></div><span class="architecture-meta">v10</span></div>
            <div><span class="architecture-icon orange"><i class="bi bi-shield-check"></i></span><div><strong>Cookie Authentication</strong><small>Security provider</small></div><span class="status-badge"><span></span>Active</span></div>
        </div>
    </article>
</section>
