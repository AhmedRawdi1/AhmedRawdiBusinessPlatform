@inject AhmedRawdiBusinessPlatform.Services.ILanguageService Lang

@{
    ViewData["Title"] = Lang.Get("Dashboard");
    var engName = User.FindFirst("UserEnglishName")?.Value;
    var arbName = User.FindFirst("UserArabicName")?.Value;
    var userDisplayName = Lang.IsRightToLeft ? (!string.IsNullOrEmpty(arbName) ? arbName : engName) : (!string.IsNullOrEmpty(engName) ? engName : User.Identity?.Name);
    var userCode = User.Identity?.Name ?? "Admin";
    var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "ahmedroodhy@gmail.com";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "System Administrator Group";
    var groupCode = User.FindFirst("GroupCode")?.Value ?? "SAG";
    var navMenu = ViewBag.NavMenu as AhmedRawdiBusinessPlatform.Models.NavigationMenuViewModel;
    var totalPagesCount = navMenu?.Modules.Sum(m => m.SubModules.Sum(sm => sm.Forms.Count)) ?? 0;
}

<!-- SB Admin Pro Page Header Banner -->
<header class="page-header page-header-dark bg-gradient-primary-to-secondary mb-4">
    <div class="container-fluid px-4">
        <div class="page-header-content pt-4 pb-4">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto mt-2 mb-2">
                    <h1 class="page-header-title">
                        <div class="page-header-icon">
                            <i class="bi bi-speedometer2"></i>
                        </div>
                        <span>@Lang.Get("BusinessPlatformDashboard")</span>
                    </h1>
                    <div class="page-header-subtitle">
                        @Lang.Get("WelcomeBack"), <strong>@userDisplayName</strong> (@userCode)! @Lang.Get("DashboardSubtitle")
                    </div>
                </div>
                <div class="col-12 col-xl-auto mt-2 mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-header-badge px-3 py-2 fs-6 shadow-sm">
                            <i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dd MMMM yyyy")
                        </span>
                        <a class="btn btn-header-action fw-semibold px-3 py-2 shadow-sm" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-arrow-clockwise me-1"></i> @Lang.Get("RefreshData")
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Main Page Content Container -->
<div class="container-fluid px-4">
    
    <!-- 4 SB Admin Pro Metric KPI Cards -->
    <div class="row">
        <!-- Metric Card 1: System User -->
        <div class="col-lg-6 col-xl-3 mb-4">
            <div class="card border-start-lg border-primary h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="me-3 ms-3">
                            <div class="metric-label text-theme-primary">@Lang.Get("LoggedUser")</div>
                            <div class="metric-value text-theme-heading">@userCode</div>
                            <div class="small text-muted mt-1">
                                <i class="bi bi-check-circle-fill text-success me-1 ms-1"></i> @Lang.Get("AuthenticationActive")
                            </div>
                        </div>
                        <div class="card-icon-tile bg-primary text-white shadow-sm">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metric Card 2: User Group -->
        <div class="col-lg-6 col-xl-3 mb-4">
            <div class="card border-start-lg border-secondary h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="me-3 ms-3">
                            <div class="metric-label text-theme-secondary">@Lang.Get("SystemGroup")</div>
                            <div class="metric-value text-theme-heading fs-4 text-truncate" style="max-width: 180px;">@groupCode</div>
                            <div class="small text-muted mt-1">@userRole</div>
                        </div>
                        <div class="card-icon-tile bg-secondary text-white shadow-sm">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metric Card 3: SQL Server Database -->
        <div class="col-lg-6 col-xl-3 mb-4">
            <div class="card border-start-lg border-success h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="me-3 ms-3">
                            <div class="metric-label text-theme-success">@Lang.Get("SqlDatabase")</div>
                            <div class="metric-value text-theme-heading">ARBP</div>
                            <div class="small text-muted mt-1">
                                <i class="bi bi-hdd-network-fill text-success me-1 ms-1"></i> AHMEDRAWDI
                            </div>
                        </div>
                        <div class="card-icon-tile bg-success text-white shadow-sm">
                            <i class="bi bi-database-fill-check"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metric Card 4: Stored Procedure User Permissions -->
        <div class="col-lg-6 col-xl-3 mb-4">
            <div class="card border-start-lg border-info h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="me-3 ms-3">
                            <div class="metric-label text-theme-info">@Lang.Get("AuthStoredProc")</div>
                            <div class="metric-value text-theme-heading fs-5 text-truncate" style="max-width: 180px;">usp_GetUserPermissions</div>
                            <div class="small text-muted mt-1">
                                <i class="bi bi-shield-check text-info me-1 ms-1"></i> @totalPagesCount @(Lang.IsRightToLeft ? "صفحة مرخصة" : "Authorized Pages")
                            </div>
                        </div>
                        <div class="card-icon-tile bg-info text-white shadow-sm">
                            <i class="bi bi-key-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Row: Data Grid Table & Navigation Menu Permissions Grid -->
    <div class="row">
        <!-- Left Table Card: Authenticated User Claims -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header justify-content-between">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-table me-2 ms-2 text-theme-primary fs-5"></i>
                        <span class="fw-semibold text-theme-heading">@Lang.Get("AuthenticatedUserDetails")</span>
                    </div>
                    <span class="badge badge-soft-success">
                        <i class="bi bi-shield-check me-1 ms-1"></i> @Lang.Get("ActiveSession")
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-theme-head">
                                <tr>
                                    <th>@Lang.Get("UserInfo")</th>
                                    <th>@Lang.Get("EmailAndMobile")</th>
                                    <th>@Lang.Get("GroupAndRole")</th>
                                    <th>@Lang.Get("AccountStatus")</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar me-3 ms-3">@(!string.IsNullOrEmpty(userDisplayName) ? userDisplayName[0].ToString() : "A")</div>
                                            <div>
                                                <div class="fw-bold text-theme-heading">@userDisplayName</div>
                                                <div class="small text-muted">@Lang.Get("UserCode"): <code>@userCode</code></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div><i class="bi bi-envelope me-1 ms-1 text-muted"></i>@userEmail</div>
                                        <div class="small text-muted"><i class="bi bi-phone me-1 ms-1"></i>0567772285</div>
                                    </td>
                                    <td>
                                        <span class="badge badge-soft-primary mb-1 d-inline-block">@groupCode</span>
                                        <div class="small text-muted">@userRole</div>
                                    </td>
                                    <td>
                                        <span class="badge badge-soft-success">
                                            <i class="bi bi-check-circle-fill me-1 ms-1"></i> @Lang.Get("Active")
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer py-3">
                    <div class="d-flex align-items-center justify-content-between small text-muted">
                        <span>Stored Proc: <code>dbo.usp_GetUserPermissions @@UserID = 0</code></span>
                        <span>Language: <strong>@(Lang.IsRightToLeft ? "العربية (Arabic)" : "English (en-US)")</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Card: Navigation Menu Loaded Pages Summary -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header justify-content-between">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-layout-sidebar-inset me-2 ms-2 text-theme-primary fs-5"></i>
                        <span class="fw-semibold text-theme-heading">@(Lang.IsRightToLeft ? "صفحات قائمة التنقل المجمعة من الإجراء المخزن" : "Navigation Menu Pages Loaded via usp_GetUserPermissions")</span>
                    </div>
                    <span class="badge badge-soft-primary">
                        @totalPagesCount @(Lang.IsRightToLeft ? "صفحة" : "Pages")
                    </span>
                </div>
                <div class="card-body" style="max-height: 380px; overflow-y: auto;">
                    @if (navMenu != null && navMenu.Modules.Any())
                    {
                        <div class="accordion" id="dashboardPermsAccordion">
                            @foreach (var mod in navMenu.Modules)
                            {
                                var accId = $"dashMod_{mod.ModuleID}";
                                <div class="accordion-item mb-2 border rounded-3 overflow-hidden">
                                    <h2 class="accordion-header" id="heading_@accId">
                                        <button class="accordion-button collapsed py-2 fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#@accId" aria-expanded="false" aria-controls="@accId">
                                            <i class="@mod.IconClass me-2 ms-2 text-theme-primary"></i>
                                            <span>@mod.Name</span>
                                            <span class="badge badge-soft-primary rounded-pill ms-auto me-2 px-2 py-1 fs-8">
                                                @mod.SubModules.Sum(sm => sm.Forms.Count)
                                            </span>
                                        </button>
                                    </h2>
                                    <div id="@accId" class="accordion-collapse collapse" aria-labelledby="heading_@accId" data-bs-parent="#dashboardPermsAccordion">
                                        <div class="accordion-body p-3">
                                            @foreach (var sub in mod.SubModules)
                                            {
                                                <div class="mb-3">
                                                    <div class="fw-bold text-theme-secondary mb-2 small d-flex align-items-center gap-1">
                                                        <i class="@sub.IconClass me-1 ms-1"></i> @sub.Name
                                                    </div>
                                                    <div class="row g-2">
                                                        @foreach (var form in sub.Forms)
                                                        {
                                                            <div class="col-md-6">
                                                                <div class="p-2 rounded-2 bg-theme-item d-flex align-items-center justify-content-between shadow-xs">
                                                                    <div class="d-flex align-items-center gap-2 text-truncate me-2">
                                                                        <i class="@form.IconClass text-theme-info"></i>
                                                                        <span class="small fw-medium text-theme-heading text-truncate">@form.Name</span>
                                                                    </div>
                                                                    <span class="badge badge-soft-success px-2 py-1 fs-8">
                                                                        <i class="bi bi-shield-check"></i>
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle me-1"></i> No permissions loaded.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
