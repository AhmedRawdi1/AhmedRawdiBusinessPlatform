@inject AhmedRawdiBusinessPlatform.Services.ILanguageService Lang
@{
    ViewData["Title"] = Lang.Get("UsersGroupsManagement");
}

<section class="management-header">
    <div>
        <span class="eyebrow-text"><i class="bi bi-shield-lock"></i>@Lang.Get("Administration")</span>
        <h1>@Lang.Get("UsersGroupsManagement")</h1>
        <p>@Lang.Get("UsersGroupsSubtitle")</p>
    </div>
    <span class="management-context"><i class="bi bi-people"></i>@Lang.Get("AccessControl")</span>
</section>

<section class="management-toolbar" aria-label="@Lang.Get("PageActions")">
    <div class="toolbar-actions">
        <button class="toolbar-button toolbar-button-primary" type="button" id="newGroupButton"><i class="bi bi-plus-lg"></i><span>@Lang.Get("New")</span></button>
        <button class="toolbar-button" type="button" id="saveGroupButton"><i class="bi bi-check2-circle"></i><span>@Lang.Get("Save")</span></button>
        <button class="toolbar-button toolbar-button-danger" type="button" id="deleteGroupButton"><i class="bi bi-trash3"></i><span>@Lang.Get("Delete")</span></button>
        <button class="toolbar-button" type="button" id="searchGroupButton"><i class="bi bi-search"></i><span>@Lang.Get("Search")</span></button>
        <button class="toolbar-button" type="button" id="exportGroupButton"><i class="bi bi-box-arrow-up"></i><span>@Lang.Get("Export")</span></button>
        <button class="toolbar-button" type="button" id="importGroupButton"><i class="bi bi-box-arrow-in-down"></i><span>@Lang.Get("Import")</span></button>
        <button class="toolbar-button" type="button" id="printGroupButton"><i class="bi bi-printer"></i><span>@Lang.Get("Print")</span></button>
        <input type="file" id="groupImportFile" class="visually-hidden" accept=".csv,.xlsx,.xls" />
    </div>
</section>

<div class="management-layout management-layout-single">
    <section class="management-panel group-editor" aria-labelledby="groupEditorTitle">
        <div class="management-panel-heading">
            <div><span class="eyebrow-text">@Lang.Get("GroupRecord")</span><h2 id="groupEditorTitle">@Lang.Get("GroupDetails")</h2></div>
            <span class="record-state"><span></span>@Lang.Get("NewRecord")</span>
        </div>
        <form id="groupEditorForm" autocomplete="off">
            @Html.AntiForgeryToken()
            <input id="groupId" name="GroupID" type="hidden" />
            <div class="management-field">
                <label for="groupCode">@Lang.Get("GroupCode") <span aria-hidden="true">*</span></label>
                <input id="groupCode" name="GroupCode" type="text" maxlength="30" placeholder="@Lang.Get("GroupCodePlaceholder")" required />
            </div>
            <div class="management-field-grid">
                <div class="management-field"><label for="groupEnglishName">@Lang.Get("EnglishName") <span aria-hidden="true">*</span></label><input id="groupEnglishName" name="EnglishName" type="text" maxlength="100" required /></div>
                <div class="management-field"><label for="groupArabicName">@Lang.Get("ArabicName")</label><input id="groupArabicName" name="ArabicName" type="text" maxlength="100" dir="rtl" /></div>
            </div>
            <div class="management-field">
                <label for="groupDescription">@Lang.Get("Description")</label>
                <textarea id="groupDescription" name="Description" rows="4" placeholder="@Lang.Get("DescriptionPlaceholder")"></textarea>
            </div>
            <label class="management-switch"><input id="groupActive" name="IsActive" type="checkbox" checked /><span class="switch-track"><span></span></span><span><strong>@Lang.Get("ActiveGroup")</strong><small>@Lang.Get("ActiveGroupHint")</small></span></label>
        </form>
    </section>

    <section class="group-access-workspace" aria-labelledby="groupAccessWorkspaceTitle">
        <div class="group-access-heading">
            <div>
                <span class="eyebrow-text">@Lang.Get("AccessConfiguration")</span>
                <h2 id="groupAccessWorkspaceTitle">@Lang.Get("GroupAccessWorkspace")</h2>
            </div>
            <span class="group-access-context"><i class="bi bi-shield-check"></i>@Lang.Get("GroupScopedSettings")</span>
        </div>
        <div class="group-tabs-scroll">
            <nav class="group-tabs-nav" role="tablist" aria-label="@Lang.Get("GroupAccessWorkspace")">
                <button class="group-tab-button active" id="formsPermissionsTab" type="button" role="tab" aria-selected="true" aria-controls="formsPermissionsPanel" data-bs-toggle="tab" data-bs-target="#formsPermissionsPanel">
                    <span class="group-tab-icon"><i class="bi bi-window-stack"></i></span>
                    <span>@Lang.Get("FormsPermissions")</span>
                </button>
                <button class="group-tab-button" id="reportsPermissionsTab" type="button" role="tab" aria-selected="false" aria-controls="reportsPermissionsPanel" data-bs-toggle="tab" data-bs-target="#reportsPermissionsPanel">
                    <span class="group-tab-icon"><i class="bi bi-file-earmark-bar-graph"></i></span>
                    <span>@Lang.Get("ReportsPermissions")</span>
                </button>
                <button class="group-tab-button" id="groupMembersTab" type="button" role="tab" aria-selected="false" aria-controls="groupMembersPanel" data-bs-toggle="tab" data-bs-target="#groupMembersPanel">
                    <span class="group-tab-icon"><i class="bi bi-people"></i></span>
                    <span>@Lang.Get("GroupMembers")</span>
                </button>
            </nav>
        </div>
        <div class="tab-content group-tabs-content">
            <div class="tab-pane fade show active" id="formsPermissionsPanel" role="tabpanel" aria-labelledby="formsPermissionsTab" tabindex="0"
                 data-new-title="@Lang.Get("NewGroupPermissions")"
                 data-selected-title="@Lang.Get("SelectedGroupPermissions")"
                 data-all-forms-hint="@Lang.Get("AllFormsDefaultHint")"
                 data-existing-hint="@Lang.Get("ExistingPermissionsHint")"
                 data-forms-label="@Lang.Get("Forms")"
                 data-enabled-label="@Lang.Get("EnabledPermissions")">
                <div class="permission-matrix-toolbar">
                    <div><strong id="permissionMatrixTitle">@Lang.Get("NewGroupPermissions")</strong><small id="permissionMatrixSubtitle">@Lang.Get("AllFormsDefaultHint")</small></div>
                    <div class="permission-summary">
                        <span class="permission-enabled-count" id="permissionEnabledCount"><i class="bi bi-check2-circle"></i><span>0 @Lang.Get("EnabledPermissions")</span></span>
                        <span class="permission-record-count" id="permissionRecordCount">0 @Lang.Get("Forms")</span>
                    </div>
                </div>
                <div class="permission-tools">
                    <label class="permission-filter" for="permissionFilterInput"><i class="bi bi-search"></i><input id="permissionFilterInput" type="search" placeholder="@Lang.Get("FilterSystemForms")" autocomplete="off" /><kbd>Ctrl K</kbd></label>
                    <span class="permission-reading-guide"><i class="bi bi-info-circle"></i>@Lang.Get("PermissionReadingGuide")</span>
                </div>
                <div class="permission-loading" id="permissionLoading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>@Lang.Get("LoadingFormsPermissions")</span></div>
                <div class="permission-error d-none" id="permissionError" role="alert"><i class="bi bi-exclamation-triangle"></i><span>@Lang.Get("FormsPermissionsLoadError")</span><button type="button" id="retryPermissionsButton">@Lang.Get("Retry")</button></div>
                <div class="permission-table-wrap d-none" id="permissionTableWrap">
                    <table class="permission-table">
                        <thead>
                            <tr>
                                <th class="permission-form-column">@Lang.Get("SystemForm")</th>
                                <th><span class="permission-column-heading"><i class="bi bi-eye"></i><span>@Lang.Get("CanView")</span></span></th>
                                <th><span class="permission-column-heading"><i class="bi bi-floppy"></i><span>@Lang.Get("CanSave")</span></span></th>
                                <th><span class="permission-column-heading permission-danger-heading"><i class="bi bi-trash3"></i><span>@Lang.Get("CanDelete")</span></span></th>
                                <th><span class="permission-column-heading"><i class="bi bi-search"></i><span>@Lang.Get("CanSearch")</span></span></th>
                                <th><span class="permission-column-heading"><i class="bi bi-printer"></i><span>@Lang.Get("CanPrint")</span></span></th>
                            </tr>
                        </thead>
                        <tbody id="permissionRows"></tbody>
                    </table>
                </div>
                <div class="group-tab-empty-state d-none" id="permissionEmptyState"><span><i class="bi bi-window-stack"></i></span><div><h3>@Lang.Get("NoSystemFormsFound")</h3><p>@Lang.Get("FormsPermissionsHint")</p></div></div>
            </div>
            <div class="tab-pane fade" id="reportsPermissionsPanel" role="tabpanel" aria-labelledby="reportsPermissionsTab" tabindex="0">
                <div class="group-tab-empty-state"><span><i class="bi bi-file-earmark-bar-graph"></i></span><div><h3>@Lang.Get("SelectGroupToManageAccess")</h3><p>@Lang.Get("ReportsPermissionsHint")</p></div></div>
            </div>
            <div class="tab-pane fade" id="groupMembersPanel" role="tabpanel" aria-labelledby="groupMembersTab" tabindex="0">
                <div class="group-tab-empty-state"><span><i class="bi bi-people"></i></span><div><h3>@Lang.Get("SelectGroupToManageAccess")</h3><p>@Lang.Get("GroupMembersHint")</p></div></div>
            </div>
        </div>
    </section>

</div>

<div class="modal fade management-directory-modal" id="groupDirectoryModal" tabindex="-1" aria-labelledby="groupDirectoryModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title-group">
                    <span class="modal-icon"><i class="bi bi-people"></i></span>
                    <div><span class="eyebrow-text">@Lang.Get("Directory")</span><h2 class="modal-title" id="groupDirectoryModalTitle">@Lang.Get("UserGroups")</h2></div>
                </div>
                <div class="modal-header-actions">
                    <span class="result-count">0 @Lang.Get("Records")</span>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body">
                <div class="management-search"><i class="bi bi-search"></i><input id="groupSearchInput" type="search" placeholder="@Lang.Get("SearchGroupsPlaceholder")" /><kbd>Enter</kbd></div>
                <div class="directory-loading" id="groupDirectoryLoading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>@Lang.Get("LoadingGroups")</span></div>
                <div class="directory-error d-none" id="groupDirectoryError"><i class="bi bi-exclamation-triangle"></i><span>@Lang.Get("GroupsLoadError")</span><button type="button" id="retryGroupsButton">@Lang.Get("Retry")</button></div>
                <div class="directory-table-wrap d-none" id="groupDirectoryTableWrap">
                    <table class="directory-table">
                        <thead><tr><th>@Lang.Get("GroupCode")</th><th>@Lang.Get("EnglishName")</th><th>@Lang.Get("ArabicName")</th><th>@Lang.Get("Status")</th><th>@Lang.Get("Registered")</th></tr></thead>
                        <tbody id="groupDirectoryRows"></tbody>
                    </table>
                </div>
                <div class="management-empty-state d-none" id="groupDirectoryEmpty">
                    <span><i class="bi bi-people"></i></span>
                    <h3>@Lang.Get("NoGroupsFound")</h3>
                    <p>@Lang.Get("NoGroupsFoundHint")</p>
                    <button class="toolbar-button toolbar-button-primary" type="button" data-focus-new><i class="bi bi-plus-lg"></i>@Lang.Get("CreateFirstGroup")</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade management-action-modal" id="groupActionModal" tabindex="-1" aria-labelledby="groupActionModalTitle" aria-hidden="true"
     data-no-selection-title="@Lang.Get("DeleteGroupNoSelectionTitle")"
     data-no-selection-message="@Lang.Get("DeleteGroupNoSelectionMessage")"
     data-confirm-title="@Lang.Get("DeleteGroupConfirmTitle")"
     data-confirm-message="@Lang.Get("DeleteGroupConfirmMessage")"
     data-not-found-message="@Lang.Get("DeleteGroupNotFoundMessage")"
     data-failed-message="@Lang.Get("DeleteGroupFailedMessage")">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-body">
                <span class="action-modal-icon" id="groupActionModalIcon"><i class="bi bi-exclamation-triangle"></i></span>
                <h2 class="modal-title" id="groupActionModalTitle"></h2>
                <p id="groupActionModalMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="toolbar-button" id="groupActionCancelButton" data-bs-dismiss="modal">@Lang.Get("Cancel")</button>
                <button type="button" class="toolbar-button toolbar-button-danger" id="groupActionConfirmButton">@Lang.Get("Delete")</button>
                <button type="button" class="toolbar-button toolbar-button-primary d-none" id="groupActionOkButton" data-bs-dismiss="modal">@Lang.Get("OK")</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('groupEditorForm');
            const groupCode = document.getElementById('groupCode');
            const directoryElement = document.getElementById('groupDirectoryModal');
            const directoryModal = directoryElement ? new bootstrap.Modal(directoryElement) : null;
            const searchInput = document.getElementById('groupSearchInput');
            const rowsElement = document.getElementById('groupDirectoryRows');
            const tableWrap = document.getElementById('groupDirectoryTableWrap');
            const emptyState = document.getElementById('groupDirectoryEmpty');
            const loadingState = document.getElementById('groupDirectoryLoading');
            const errorState = document.getElementById('groupDirectoryError');
            const resultCount = directoryElement?.querySelector('.result-count');
            const actionElement = document.getElementById('groupActionModal');
            const actionModal = actionElement ? new bootstrap.Modal(actionElement) : null;
            const actionTitle = document.getElementById('groupActionModalTitle');
            const actionMessage = document.getElementById('groupActionModalMessage');
            const actionIcon = document.getElementById('groupActionModalIcon');
            const actionCancel = document.getElementById('groupActionCancelButton');
            const actionConfirm = document.getElementById('groupActionConfirmButton');
            const actionOk = document.getElementById('groupActionOkButton');
            const deleteButton = document.getElementById('deleteGroupButton');
            const permissionPanel = document.getElementById('formsPermissionsPanel');
            const permissionLoading = document.getElementById('permissionLoading');
            const permissionError = document.getElementById('permissionError');
            const permissionTableWrap = document.getElementById('permissionTableWrap');
            const permissionRows = document.getElementById('permissionRows');
            const permissionEmptyState = document.getElementById('permissionEmptyState');
            const permissionRecordCount = document.getElementById('permissionRecordCount');
            const permissionMatrixTitle = document.getElementById('permissionMatrixTitle');
            const permissionMatrixSubtitle = document.getElementById('permissionMatrixSubtitle');
            const permissionEnabledCount = document.getElementById('permissionEnabledCount');
            const permissionFilterInput = document.getElementById('permissionFilterInput');
            let groups = [];
            let formPermissions = [];
            let permissionRequestController = null;
            let permissionLoadContext = { mode: 'new', groupId: null };

            const resetEditor = () => { form?.reset(); document.getElementById('groupId').value = ''; document.getElementById('groupActive').checked = true; loadFormPermissions('new'); groupCode?.focus(); };
            const showActionModal = (title, message, confirmation = false) => {
                actionTitle.textContent = title;
                actionMessage.textContent = message;
                actionIcon.classList.toggle('confirmation', confirmation);
                actionIcon.innerHTML = confirmation ? '<i class="bi bi-trash3"></i>' : '<i class="bi bi-exclamation-triangle"></i>';
                actionCancel.classList.toggle('d-none', !confirmation);
                actionConfirm.classList.toggle('d-none', !confirmation);
                actionOk.classList.toggle('d-none', confirmation);
                actionModal?.show();
            };
            const deleteSelectedGroup = async () => {
                const groupId = document.getElementById('groupId').value;
                if (groupId === '') {
                    showActionModal(actionElement.dataset.noSelectionTitle, actionElement.dataset.noSelectionMessage);
                    return;
                }

                showActionModal(actionElement.dataset.confirmTitle, actionElement.dataset.confirmMessage, true);
            };
            const confirmGroupDeletion = async () => {
                const groupId = document.getElementById('groupId').value;
                if (groupId === '') {
                    actionModal?.hide();
                    showActionModal(actionElement.dataset.noSelectionTitle, actionElement.dataset.noSelectionMessage);
                    return;
                }

                actionConfirm.disabled = true;
                deleteButton.disabled = true;
                try {
                    const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const body = new URLSearchParams({ groupId });
                    const response = await fetch('@Url.Action("DeleteGroup", "Administration")', {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                            'RequestVerificationToken': token || ''
                        },
                        body
                    });
                    const result = await response.json().catch(() => ({ code: 'DeleteFailed' }));
                    if (!response.ok || !result.success) {
                        throw new Error(result.code || 'DeleteFailed');
                    }

                    actionModal?.hide();
                    resetEditor();
                    groups = groups.map(group => String(group.groupID) === String(groupId) ? { ...group, isActive: false } : group);
                    renderGroups();
                } catch (error) {
                    const message = error.message === 'GroupNotFound'
                        ? actionElement.dataset.notFoundMessage
                        : actionElement.dataset.failedMessage;
                    showActionModal(actionElement.dataset.noSelectionTitle, message);
                } finally {
                    actionConfirm.disabled = false;
                    deleteButton.disabled = false;
                }
            };
            const displayName = group => document.documentElement.dir === 'rtl' ? (group.groupArabicName || group.groupEnglishName) : (group.groupEnglishName || group.groupArabicName);
            const permissionName = (item, englishProperty, arabicProperty) => document.documentElement.dir === 'rtl'
                ? (item[arabicProperty] || item[englishProperty])
                : (item[englishProperty] || item[arabicProperty]);
            const createPermissionCheckbox = (item, property, label) => {
                const wrapper = document.createElement('label');
                wrapper.className = 'permission-checkbox';
                const input = document.createElement('input');
                input.type = 'checkbox';
                input.checked = item[property] === true;
                input.dataset.formId = item.formID;
                input.dataset.permission = property;
                input.setAttribute('aria-label', `${label}: ${permissionName(item, 'formEnglishName', 'formArabicName')}`);
                const visual = document.createElement('span');
                visual.innerHTML = '<i class="bi bi-check"></i>';
                wrapper.append(input, visual);
                return wrapper;
            };
            const renderFormPermissions = items => {
                permissionRows.replaceChildren();
                const permissionLabels = ['@Lang.Get("CanView")', '@Lang.Get("CanSave")', '@Lang.Get("CanDelete")', '@Lang.Get("CanSearch")', '@Lang.Get("CanPrint")'];
                const permissionProperties = ['canView', 'canSave', 'canDelete', 'canSearch', 'canPrint'];
                items.forEach(item => {
                    const row = document.createElement('tr');
                    row.dataset.formId = item.formID;
                    const formCell = document.createElement('td');
                    formCell.className = 'permission-form-cell';
                    const moduleName = permissionName(item, 'moduleEnglishName', 'moduleArabicName');
                    const subModuleName = permissionName(item, 'subModuleEnglishName', 'subModuleArabicName');
                    const module = document.createElement('span');
                    module.className = 'permission-module-name';
                    module.innerHTML = '<i class="bi bi-grid"></i>';
                    module.append(document.createTextNode(moduleName || '@Lang.Get("SystemForm")'));
                    const formName = document.createElement('strong');
                    formName.textContent = permissionName(item, 'formEnglishName', 'formArabicName');
                    const hierarchy = document.createElement('small');
                    hierarchy.textContent = [subModuleName, item.formCode].filter(Boolean).join('  •  ');
                    formCell.append(module, formName, hierarchy);
                    row.appendChild(formCell);
                    permissionProperties.forEach((property, index) => {
                        const cell = document.createElement('td');
                        cell.appendChild(createPermissionCheckbox(item, property, permissionLabels[index]));
                        row.appendChild(cell);
                    });
                    permissionRows.appendChild(row);
                });
                permissionRecordCount.textContent = `${items.length} ${permissionPanel.dataset.formsLabel}`;
                const enabled = items.reduce((total, item) => total + permissionProperties.filter(property => item[property] === true).length, 0);
                permissionEnabledCount.querySelector('span').textContent = `${enabled} ${permissionPanel.dataset.enabledLabel}`;
                permissionTableWrap.classList.toggle('d-none', items.length === 0);
                permissionEmptyState.classList.toggle('d-none', items.length !== 0);
            };
            const filterFormPermissions = () => {
                const term = (permissionFilterInput?.value || '').trim().toLocaleLowerCase();
                const filtered = formPermissions.filter(item => [item.formEnglishName, item.formArabicName, item.formCode, item.moduleEnglishName, item.moduleArabicName, item.subModuleEnglishName, item.subModuleArabicName]
                    .some(value => (value || '').toLocaleLowerCase().includes(term)));
                renderFormPermissions(filtered);
            };
            const loadFormPermissions = async (mode, groupId = null) => {
                permissionLoadContext = { mode, groupId };
                permissionRequestController?.abort();
                const requestController = new AbortController();
                permissionRequestController = requestController;
                permissionMatrixTitle.textContent = mode === 'existing' ? permissionPanel.dataset.selectedTitle : permissionPanel.dataset.newTitle;
                permissionMatrixSubtitle.textContent = mode === 'existing' ? permissionPanel.dataset.existingHint : permissionPanel.dataset.allFormsHint;
                permissionLoading.classList.remove('d-none');
                permissionError.classList.add('d-none');
                permissionTableWrap.classList.add('d-none');
                permissionEmptyState.classList.add('d-none');
                try {
                    const endpoint = mode === 'existing'
                        ? `@Url.Action("GetGroupPermissions", "Administration")?groupId=${encodeURIComponent(groupId)}`
                        : '@Url.Action("GetAllSystemForms", "Administration")';
                    const response = await fetch(endpoint, { headers: { 'Accept': 'application/json' }, signal: requestController.signal });
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    formPermissions = await response.json();
                    permissionFilterInput.value = '';
                    renderFormPermissions(formPermissions);
                } catch (error) {
                    if (error.name === 'AbortError') return;
                    console.error('Unable to load form permissions.', error);
                    permissionRecordCount.textContent = `0 ${permissionPanel.dataset.formsLabel}`;
                    permissionError.classList.remove('d-none');
                } finally {
                    if (permissionRequestController === requestController) permissionLoading.classList.add('d-none');
                }
            };
            permissionFilterInput?.addEventListener('input', filterFormPermissions);
            permissionRows?.addEventListener('change', event => {
                const input = event.target.closest('input[type="checkbox"]');
                if (!input) return;
                const item = formPermissions.find(entry => String(entry.formID) === input.dataset.formId);
                if (item) item[input.dataset.permission] = input.checked;
                filterFormPermissions();
            });
            document.addEventListener('keydown', event => {
                if ((event.ctrlKey || event.metaKey) && event.key.toLocaleLowerCase() === 'k') {
                    event.preventDefault();
                    permissionFilterInput?.focus();
                }
            });
            const renderGroups = () => {
                const term = (searchInput?.value || '').trim().toLocaleLowerCase();
                const filtered = groups.filter(group => [group.groupCode, group.groupEnglishName, group.groupArabicName].some(value => (value || '').toLocaleLowerCase().includes(term)));
                rowsElement.replaceChildren();
                filtered.forEach(group => {
                    const row = document.createElement('tr');
                    row.tabIndex = 0;
                    row.setAttribute('role', 'button');
                    row.setAttribute('aria-label', displayName(group));
                    const values = [group.groupCode, group.groupEnglishName, group.groupArabicName];
                    values.forEach(value => { const cell = document.createElement('td'); cell.textContent = value || '—'; row.appendChild(cell); });
                    const status = document.createElement('td');
                    status.innerHTML = group.isActive ? '<span class="group-status active">@Lang.Get("Active")</span>' : '<span class="group-status inactive">@Lang.Get("Inactive")</span>';
                    row.appendChild(status);
                    const registered = document.createElement('td');
                    registered.textContent = group.regDate ? new Intl.DateTimeFormat(document.documentElement.lang).format(new Date(group.regDate)) : '—';
                    row.appendChild(registered);
                    const selectGroup = () => {
                        document.getElementById('groupId').value = group.groupID;
                        groupCode.value = group.groupCode || '';
                        document.getElementById('groupEnglishName').value = group.groupEnglishName || '';
                        document.getElementById('groupArabicName').value = group.groupArabicName || '';
                        document.getElementById('groupActive').checked = group.isActive;
                        loadFormPermissions('existing', group.groupID);
                        directoryModal?.hide();
                    };
                    row.addEventListener('click', selectGroup);
                    row.addEventListener('keydown', event => { if (event.key === 'Enter') selectGroup(); });
                    rowsElement.appendChild(row);
                });
                resultCount.textContent = `${filtered.length} @Lang.Get("Records")`;
                tableWrap.classList.toggle('d-none', filtered.length === 0);
                emptyState.classList.toggle('d-none', filtered.length !== 0);
            };
            const loadGroups = async () => {
                loadingState.classList.remove('d-none'); errorState.classList.add('d-none'); tableWrap.classList.add('d-none'); emptyState.classList.add('d-none');
                try {
                    const response = await fetch('@Url.Action("GetAllGroups", "Administration")', { headers: { 'Accept': 'application/json' } });
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    groups = await response.json();
                    renderGroups();
                } catch (error) {
                    console.error('Unable to load user groups.', error);
                    errorState.classList.remove('d-none');
                } finally { loadingState.classList.add('d-none'); }
            };

            const saveGroup = async () => {
                if (!form?.checkValidity()) {
                    form?.reportValidity();
                    return;
                }

                const saveButton = document.getElementById('saveGroupButton');
                if (saveButton) saveButton.disabled = true;

                try {
                    const formData = new FormData(form);
                    formData.set('IsActive', document.getElementById('groupActive').checked ? 'true' : 'false');

                    const permissionsData = formPermissions.map(item => ({
                        FormID: item.formID,
                        CanSave: item.canView === true || item.canSave === true,
                        CanUpdate: item.canSave === true,
                        CanDelete: item.canDelete === true,
                        CanSearch: item.canSearch === true,
                        CanPrint: item.canPrint === true
                    }));

                    formData.set('PermissionsJson', JSON.stringify(permissionsData));

                    const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const response = await fetch('@Url.Action("SaveGroup", "Administration")', {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                            'RequestVerificationToken': token || ''
                        },
                        body: formData
                    });

                    const result = await response.json().catch(() => ({ success: false }));
                    if (!response.ok || !result.success) {
                        throw new Error(result.message || 'SaveFailed');
                    }

                    if (result.groupId) {
                        document.getElementById('groupId').value = result.groupId;
                    }

                    showActionModal(
                        document.documentElement.dir === 'rtl' ? 'تم الحفظ' : 'Saved Successfully',
                        document.documentElement.dir === 'rtl' ? 'تم حفظ بيانات المجموعة والصلاحيات بنجاح.' : 'Group details and form permissions have been saved successfully.'
                    );

                    loadGroups();
                } catch (error) {
                    console.error('Save group failed:', error);
                    showActionModal(
                        document.documentElement.dir === 'rtl' ? 'خطأ في الحفظ' : 'Save Failed',
                        error.message || (document.documentElement.dir === 'rtl' ? 'تعذر حفظ بيانات المجموعة.' : 'Unable to save group details.')
                    );
                } finally {
                    if (saveButton) saveButton.disabled = false;
                }
            };

            document.getElementById('newGroupButton')?.addEventListener('click', resetEditor);
            document.getElementById('saveGroupButton')?.addEventListener('click', saveGroup);
            form?.addEventListener('submit', event => { event.preventDefault(); saveGroup(); });
            deleteButton?.addEventListener('click', deleteSelectedGroup);
            actionConfirm?.addEventListener('click', confirmGroupDeletion);
            document.querySelector('[data-focus-new]')?.addEventListener('click', () => { resetEditor(); directoryModal?.hide(); directoryElement?.addEventListener('hidden.bs.modal', () => groupCode?.focus(), { once: true }); });
            document.getElementById('searchGroupButton')?.addEventListener('click', () => directoryModal?.show());
            directoryElement?.addEventListener('shown.bs.modal', () => { searchInput?.focus(); loadGroups(); });
            searchInput?.addEventListener('input', renderGroups);
            document.getElementById('retryGroupsButton')?.addEventListener('click', loadGroups);
            document.getElementById('retryPermissionsButton')?.addEventListener('click', () => loadFormPermissions(permissionLoadContext.mode, permissionLoadContext.groupId));
            document.getElementById('importGroupButton')?.addEventListener('click', () => document.getElementById('groupImportFile')?.click());
            document.getElementById('printGroupButton')?.addEventListener('click', () => window.print());
            loadFormPermissions('new');
        })();
    </script>
}
