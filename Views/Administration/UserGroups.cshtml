@inject AhmedRawdiBusinessPlatform.Services.ILanguageService Lang
@{
    ViewData["Title"] = Lang.Get("UsersGroupsManagement");
}

<section class="management-header">
    <div>
        <span class="eyebrow-text"><i class="bi bi-shield-lock"></i>@Lang.Get("Administration")</span>
        <h1>@Lang.Get("UsersGroupsManagement")</h1>
        <p>@Lang.Get("UsersGroupsSubtitle")</p>
    </div>
    <span class="management-context"><i class="bi bi-people"></i>@Lang.Get("AccessControl")</span>
</section>

<section class="management-toolbar" aria-label="@Lang.Get("PageActions")">
    <div class="toolbar-primary-actions">
        <button class="toolbar-button toolbar-button-primary" type="button" id="newGroupButton"><i class="bi bi-plus-lg"></i><span>@Lang.Get("New")</span></button>
        <button class="toolbar-button" type="button" id="saveGroupButton"><i class="bi bi-check2-circle"></i><span>@Lang.Get("Save")</span></button>
        <button class="toolbar-button toolbar-button-danger" type="button" id="deleteGroupButton"><i class="bi bi-trash3"></i><span>@Lang.Get("Delete")</span></button>
        <span class="toolbar-divider" aria-hidden="true"></span>
        <button class="toolbar-button" type="button" id="searchGroupButton"><i class="bi bi-search"></i><span>@Lang.Get("Search")</span></button>
    </div>
    <div class="toolbar-secondary-actions">
        <button class="toolbar-button" type="button" id="exportGroupButton"><i class="bi bi-box-arrow-up"></i><span>@Lang.Get("Export")</span></button>
        <button class="toolbar-button" type="button" id="importGroupButton"><i class="bi bi-box-arrow-in-down"></i><span>@Lang.Get("Import")</span></button>
        <button class="toolbar-button" type="button" id="printGroupButton"><i class="bi bi-printer"></i><span>@Lang.Get("Print")</span></button>
        <input type="file" id="groupImportFile" class="visually-hidden" accept=".csv,.xlsx,.xls" />
    </div>
</section>

<div class="management-layout management-layout-single">
    <section class="management-panel group-editor" aria-labelledby="groupEditorTitle">
        <div class="management-panel-heading">
            <div><span class="eyebrow-text">@Lang.Get("GroupRecord")</span><h2 id="groupEditorTitle">@Lang.Get("GroupDetails")</h2></div>
            <span class="record-state"><span></span>@Lang.Get("NewRecord")</span>
        </div>
        <form id="groupEditorForm" autocomplete="off">
            <div class="management-field">
                <label for="groupCode">@Lang.Get("GroupCode") <span aria-hidden="true">*</span></label>
                <input id="groupCode" name="GroupCode" type="text" maxlength="30" placeholder="@Lang.Get("GroupCodePlaceholder")" required />
            </div>
            <div class="management-field-grid">
                <div class="management-field"><label for="groupEnglishName">@Lang.Get("EnglishName") <span aria-hidden="true">*</span></label><input id="groupEnglishName" name="EnglishName" type="text" maxlength="100" required /></div>
                <div class="management-field"><label for="groupArabicName">@Lang.Get("ArabicName")</label><input id="groupArabicName" name="ArabicName" type="text" maxlength="100" dir="rtl" /></div>
            </div>
            <div class="management-field">
                <label for="groupDescription">@Lang.Get("Description")</label>
                <textarea id="groupDescription" name="Description" rows="4" placeholder="@Lang.Get("DescriptionPlaceholder")"></textarea>
            </div>
            <label class="management-switch"><input id="groupActive" name="IsActive" type="checkbox" checked /><span class="switch-track"><span></span></span><span><strong>@Lang.Get("ActiveGroup")</strong><small>@Lang.Get("ActiveGroupHint")</small></span></label>
        </form>
    </section>

</div>

<div class="modal fade management-directory-modal" id="groupDirectoryModal" tabindex="-1" aria-labelledby="groupDirectoryModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title-group">
                    <span class="modal-icon"><i class="bi bi-people"></i></span>
                    <div><span class="eyebrow-text">@Lang.Get("Directory")</span><h2 class="modal-title" id="groupDirectoryModalTitle">@Lang.Get("UserGroups")</h2></div>
                </div>
                <div class="modal-header-actions">
                    <span class="result-count">0 @Lang.Get("Records")</span>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body">
                <div class="management-search"><i class="bi bi-search"></i><input id="groupSearchInput" type="search" placeholder="@Lang.Get("SearchGroupsPlaceholder")" /><kbd>Enter</kbd></div>
                <div class="management-empty-state">
                    <span><i class="bi bi-people"></i></span>
                    <h3>@Lang.Get("NoGroupsLoaded")</h3>
                    <p>@Lang.Get("NoGroupsLoadedHint")</p>
                    <button class="toolbar-button toolbar-button-primary" type="button" data-focus-new><i class="bi bi-plus-lg"></i>@Lang.Get("CreateFirstGroup")</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('groupEditorForm');
            const groupCode = document.getElementById('groupCode');
            const directoryElement = document.getElementById('groupDirectoryModal');
            const directoryModal = directoryElement ? new bootstrap.Modal(directoryElement) : null;
            document.getElementById('newGroupButton')?.addEventListener('click', () => { form?.reset(); document.getElementById('groupActive').checked = true; groupCode?.focus(); });
            document.querySelector('[data-focus-new]')?.addEventListener('click', () => { directoryModal?.hide(); directoryElement?.addEventListener('hidden.bs.modal', () => groupCode?.focus(), { once: true }); });
            document.getElementById('searchGroupButton')?.addEventListener('click', () => directoryModal?.show());
            directoryElement?.addEventListener('shown.bs.modal', () => document.getElementById('groupSearchInput')?.focus());
            document.getElementById('importGroupButton')?.addEventListener('click', () => document.getElementById('groupImportFile')?.click());
            document.getElementById('printGroupButton')?.addEventListener('click', () => window.print());
        })();
    </script>
}
